# Grabit extension env (실제 값은 .env / .env.local — 커밋 금지). WXT가 빌드 시 import.meta.env에
# 인라인. WXT_* 우선, VITE_*도 허용(apps/web과 동일 Supabase 프로젝트 공유 시).
# anon 키 = RLS 보호 public 키(ADR-0001) — 시크릿/서비스롤 ❌. 외부 LLM/API 키 ❌(서버 ingest만).

# Supabase 프로젝트 (clip-ingest Edge Function 호출 + folders 조회 + 세션).
WXT_SUPABASE_URL=
WXT_SUPABASE_ANON_KEY=

# 웹 앱 오리진 — 로그인 팝업 목적지(웹 세션 획득 후 토큰 핸드오프). 미설정 시 로그인 미배선.
# externally_connectable matches(wxt.config.ts)와 오리진이 일치해야 핸드오프가 동작.
WXT_WEB_APP_URL=
