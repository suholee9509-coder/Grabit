# Grabit 에이전트 시스템 환경변수
# 이 파일을 .env로 복사하고 실제 값을 채워넣으세요.

# GitHub 통합 (gh CLI가 사용)
# Personal Access Token. 권한: repo, workflow, read:org
# 생성: https://github.com/settings/tokens
GITHUB_TOKEN=

# (선택) GitHub Projects 번호 — scripts/status.sh 등에서 활용 가능
# GITHUB_PROJECT_NUMBER=2

# 참고: Anthropic API 키는 사용하지 않습니다.
# 모든 LLM 호출은 Cursor의 Claude Code (사용자 구독 계정)를 통해 이루어집니다.
