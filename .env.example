# Grabit env (실제 값은 .env.local / .env — 커밋 금지). 스택 = Sprint 0 ADR로 확정.
# 클라이언트 번들에 노출되는 변수(예: Vite VITE_*)에는 절대 시크릿/프로바이더 키를 넣지 말 것.
# 모든 LLM/외부 API 키 호출은 서버(엣지 함수/백엔드)에서만 — config/quality_standards.md §5.

# --- 클라이언트 (브라우저 안전 값만) ---
# 예: 백엔드 공개 URL · anon/public 키(권한 보호된 것만)
# VITE_API_URL=
# VITE_PUBLIC_ANON_KEY=

# --- u1 인증/온보딩 (브라우저 안전 — anon 키는 RLS 보호 공개 키, ADR-0001) ---
# Supabase Auth(OAuth Google/Kakao) + complete_onboarding/is_onboarded RPC 호출용.
# 미설정 시 FE는 결정론적 목 경로로 폴백(로컬·데모). 실배선 시 둘 다 주입.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# 확장 웹스토어 URL(E4 — 실제 확장 ID는 u6에서 주입). 미설정 시 웹스토어 홈 폴백.
# VITE_EXTENSION_WEBSTORE_URL=
# 약관/개인정보 링크(E6 — 법무 페이지 별도 단위 전 플레이스홀더).
# VITE_TERMS_URL=
# VITE_PRIVACY_URL=

# --- 서버 전용 (시크릿 — 클라이언트 번들 금지, 서버 시크릿 매니저로만 주입) ---
# SERVER_API_KEY=
# LLM_PROVIDER_API_KEY=

# --- GitHub 오케스트레이션 (스크립트는 gh CLI 키체인 인증 사용 — 아래는 선택) ---
# GITHUB_PROJECT_NUMBER=2
